<?xml version="1.0" encoding="UTF-8"?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="036ddc86-3b96-4a35-ae42-81e05b1067ea" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2025.3/project-config.xsd">
  <name>Build</name>
  <description />
  <settings>
    <options>
      <option name="allowExternalStatus" value="true" />
      <option name="buildNumberPattern" value="0.0.%build.counter%" />
    </options>
    <parameters>
      <param name="SONAR_TOKEN" value="dd563421c5305ddf31a0cea9cc1c41a747e2f88d" spec="text display='normal' readOnly='true' validationMode='any'" />
      <param name="env.SONAR_TOKEN" value="dd563421c5305ddf31a0cea9cc1c41a747e2f88d" spec="text display='normal' readOnly='true' validationMode='any'" />
      <param name="sonar.exclusions" value="*/*.xml,**/config/*,**/config/*,**/config/security/*,**/interceptor/*,**/loggers/interceptor/*,**/exception/*,**/mapper/*,**/util/*,**/converter/*,**/*Test*,**/JwtConverter.*,**/*.java" spec="text display='normal' readOnly='true' label='sonar.exclusions' validationMode='any'" />
      <param name="sonar.organization" value="lamm" spec="text display='normal' readOnly='true' label='sonar.organization' validationMode='any'" />
      <param name="sonar.projectKey" value="lamm" spec="text display='normal' readOnly='true' validationMode='any'" />
      <param name="sonar.projectName" value="lanmata_security-oauth" spec="text display='normal' readOnly='true' validationMode='any'" />
    </parameters>
    <build-runners>
      <runner id="Maven2" name="" type="Maven2">
        <parameters>
          <param name="goals" value="clean package test" />
          <param name="localRepoScope" value="agent" />
          <param name="maven.path" value="%teamcity.tool.maven.DEFAULT%" />
          <param name="pomLocation" value="pom.xml" />
          <param name="runnerArgs" value="-Dmaven.test.failure.ignore=true" />
          <param name="target.jdk.home" value="%env.JDK_21_0_x64%" />
          <param name="teamcity.step.mode" value="default" />
          <param name="userSettingsSelection" value="Repsy Maven" />
        </parameters>
      </runner>
      <runner id="Sonarcloud" name="Sonarcloud" type="sonar-plugin">
        <parameters>
          <param name="jvmArgs" value="-Dsonar.organization=%sonar.organization% -Dsonar.projectKey=%sonar.projectKey% -Dsonar.token=%SONAR_TOKEN%  -Dsonar.exclusions=%sonar.exclusions%" />
          <param name="sonarProjectKey" value="%sonar.projectName%" />
          <param name="sonarProjectName" value="%system.teamcity.projectName%" />
          <param name="sonarProjectSources" value="src" />
          <param name="sonarProjectVersion" value="%build.number%" />
          <param name="sonarServer" value="361583d7-7a30-4718-b1c0-2e070f900874" />
          <param name="target.jdk.home" value="%env.JDK_21_0_x64%" />
          <param name="teamcity.step.mode" value="default" />
          <param name="teamcity.tool.sonarquberunner" value="%teamcity.tool.sonar-qube-scanner.DEFAULT%" />
        </parameters>
      </runner>
      <runner id="Deploy_1" name="Deploy" type="Maven2">
        <conditions>
          <equals name="teamcity.build.branch" value="develop" />
        </conditions>
        <parameters>
          <param name="goals" value="deploy" />
          <param name="localRepoScope" value="agent" />
          <param name="maven.path" value="%teamcity.tool.maven.DEFAULT%" />
          <param name="pomLocation" value="pom.xml" />
          <param name="target.jdk.home" value="%env.JDK_21_0_x64%" />
          <param name="teamcity.coverage.emma.include.source" value="true" />
          <param name="teamcity.coverage.emma.instr.parameters" value="-ix -*Test*" />
          <param name="teamcity.coverage.idea.includePatterns" value="*" />
          <param name="teamcity.coverage.jacoco.classpath" value="." />
          <param name="teamcity.coverage.jacoco.patterns" value="+:*" />
          <param name="teamcity.step.mode" value="default" />
          <param name="teamcity.tool.jacoco" value="%teamcity.tool.jacoco.DEFAULT%" />
          <param name="userSettingsSelection" value="Maven Repsy" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings>
      <vcs-entry-ref root-id="SecurityOauth_HttpsGithubComLanmataSecurityOauthRefsHeadsDevelop" />
    </vcs-settings>
    <build-triggers>
      <build-trigger id="TRIGGER_2" type="vcsTrigger">
        <parameters>
          <param name="branchFilter" value="+:*" />
          <param name="enableQueueOptimization" value="true" />
          <param name="quietPeriodMode" value="DO_NOT_USE" />
        </parameters>
      </build-trigger>
    </build-triggers>
    <build-extensions>
      <extension id="perfmon" type="perfmon">
        <parameters>
          <param name="teamcity.perfmon.feature.enabled" value="true" />
        </parameters>
      </extension>
    </build-extensions>
  </settings>
</build-type>

