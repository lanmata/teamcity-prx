<?xml version="1.0" encoding="UTF-8"?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="98046d3d-116b-47c4-92ee-be730e97553b" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2025.3/project-config.xsd">
  <name>Build</name>
  <description />
  <settings>
    <options>
      <option name="allowExternalStatus" value="true" />
      <option name="buildNumberPattern" value="0.0.%build.counter%" />
    </options>
    <disabled-settings>
      <setting-ref ref="DockerCommand" />
      <setting-ref ref="Qodana" />
    </disabled-settings>
    <parameters>
      <param name="SONAR_TOKEN" value="c2def6536a67b49657d57ecf1699bafeb220c4ae" />
      <param name="env.SONAR_TOKEN" value="c2def6536a67b49657d57ecf1699bafeb220c4ae" spec="text display='normal' readOnly='true' validationMode='any'" />
      <param name="sonar.exclusions"><![CDATA[**/*.xml,**/*Application.*,**/exceptions/*, **/config/*,**/loggers/*,**/interceptor/*,**/mapper/*, **/*Test.*, **/cache/*,
            **/cache/domain/*,**/repository/*,**/*Entity.*,**/*Document.*,**/kafka/listener/*,**/mercury/security/*,**/processor/*]]></param>
      <param name="sonar.organization" value="umdevc" spec="text display='normal' readOnly='true' validationMode='any'" />
      <param name="sonar.projectKey" value="umdc-mercury" spec="text display='normal' readOnly='true' validationMode='any'" />
      <param name="sonar.projectName" value="umdc-mercury" spec="text display='normal' readOnly='true' validationMode='any'" />
    </parameters>
    <build-runners>
      <runner id="Maven2" name="Maven" type="Maven2">
        <parameters>
          <param name="goals" value="clean test" />
          <param name="localRepoScope" value="agent" />
          <param name="maven.path" value="%teamcity.tool.maven.DEFAULT%" />
          <param name="pomLocation" value="pom.xml" />
          <param name="runnerArgs" value="-Dmaven.test.failure.ignore=true" />
          <param name="target.jdk.home" value="%env.JDK_21_0_x64%" />
          <param name="teamcity.coverage.jacoco.classpath" value="." />
          <param name="teamcity.step.mode" value="default" />
          <param name="userSettingsSelection" value="Repsy Maven" />
        </parameters>
      </runner>
      <runner id="Sonarcloud" name="Sonarcloud" type="sonar-plugin">
        <conditions>
          <equals name="teamcity.build.branch" value="develop" />
        </conditions>
        <parameters>
          <param name="jvmArgs" value="-Dsonar.organization=%sonar.organization% -Dsonar.projectKey=%sonar.projectKey% -Dsonar.token=%SONAR_TOKEN%  -Dsonar.exclusions=%sonar.exclusions%" />
          <param name="sonarProjectKey" value="%sonar.projectKey%" />
          <param name="sonarProjectName" value="%sonar.projectName%" />
          <param name="sonarProjectSources" value="src" />
          <param name="sonarProjectVersion" value="%build.number%" />
          <param name="sonarServer" value="5fa30e4f-0c21-4c26-8e65-51d6675a3084" />
          <param name="target.jdk.home" value="%env.JDK_21_0_x64%" />
          <param name="teamcity.step.mode" value="default" />
          <param name="teamcity.tool.sonarquberunner" value="%teamcity.tool.sonar-qube-scanner.DEFAULT%" />
        </parameters>
      </runner>
      <runner id="Qodana" name="" type="Qodana">
        <parameters>
          <param name="linterVersion" value="latest" />
          <param name="namesAndTags" value="public-image-qodana-jvm-community" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
      <runner id="DockerCommand" name="" type="DockerCommand">
        <parameters>
          <param name="docker.command.type" value="build" />
          <param name="docker.push.remove.image" value="true" />
          <param name="dockerfile.path" value="Dockerfile" />
          <param name="dockerfile.source" value="PATH" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings>
      <vcs-entry-ref root-id="Mercury_HttpsGithubComUmDevCreativeMercuryGitRefsHeadsMain" />
    </vcs-settings>
    <build-triggers>
      <build-trigger id="TRIGGER_8" type="vcsTrigger">
        <parameters>
          <param name="branchFilter" value="+:*" />
          <param name="enableQueueOptimization" value="true" />
          <param name="quietPeriodMode" value="DO_NOT_USE" />
        </parameters>
      </build-trigger>
    </build-triggers>
    <build-extensions>
      <extension id="perfmon" type="perfmon">
        <parameters>
          <param name="teamcity.perfmon.feature.enabled" value="true" />
        </parameters>
      </extension>
      <extension id="BUILD_EXT_8" type="BuildFailureOnMetric">
        <parameters>
          <param name="anchorBuild" value="lastSuccessful" />
          <param name="metricKey" value="buildTestCount" />
          <param name="metricThreshold" value="20" />
          <param name="metricUnits" value="metricUnitsPercents" />
          <param name="moreOrLess" value="less" />
          <param name="withBuildAnchor" value="true" />
        </parameters>
      </extension>
    </build-extensions>
  </settings>
</build-type>

