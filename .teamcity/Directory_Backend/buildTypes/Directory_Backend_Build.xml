<?xml version="1.0" encoding="UTF-8"?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="08b33659-b83c-463c-91e8-253f5a7f9722" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2025.3/project-config.xsd">
  <name>Build</name>
  <description />
  <settings>
    <options>
      <option name="buildNumberPattern" value="0.0.%build.counter%" />
    </options>
    <disabled-settings>
      <setting-ref ref="Maven2" />
      <setting-ref ref="Qodana" />
      <setting-ref ref="certificates_loader" />
    </disabled-settings>
    <parameters>
      <param name="build.certificateDestinationPath" value="%system.teamcity.build.workingDir%" spec="text display='normal' readOnly='true' validationMode='any'" />
      <param name="maven.project.name" value="directory-backend" />
    </parameters>
    <build-runners>
      <runner id="Maven2" name="Maven test" type="Maven2">
        <parameters>
          <param name="goals" value="clean test" />
          <param name="localRepoScope" value="agent" />
          <param name="maven.path" value="%teamcity.tool.maven.DEFAULT%" />
          <param name="pomLocation" value="pom.xml" />
          <param name="runnerArgs" value="-Dmaven.test.failure.ignore=true" />
          <param name="target.jdk.home" value="%env.JDK_21_0_x64%" />
          <param name="teamcity.step.mode" value="default" />
          <param name="userSettingsSelection" value="Repsy Maven" />
        </parameters>
      </runner>
      <runner id="Maven_Build" name="Maven Build" type="Maven2">
        <parameters>
          <param name="goals" value="clean package" />
          <param name="jvmArgs" value="--enable-native-access=ALL-UNNAMED" />
          <param name="localRepoScope" value="agent" />
          <param name="maven.path" value="%teamcity.tool.maven.DEFAULT%" />
          <param name="pomLocation" value="pom.xml" />
          <param name="teamcity.coverage.emma.include.source" value="true" />
          <param name="teamcity.coverage.emma.instr.parameters" value="-ix -*Test*" />
          <param name="teamcity.coverage.idea.includePatterns" value="*" />
          <param name="teamcity.coverage.jacoco.patterns" value="+:*" />
          <param name="teamcity.step.mode" value="default" />
          <param name="teamcity.tool.jacoco" value="%teamcity.tool.jacoco.DEFAULT%" />
          <param name="userSettingsSelection" value="Repsy Maven" />
        </parameters>
      </runner>
      <runner id="Qodana" name="" type="Qodana">
        <parameters>
          <param name="linterVersion" value="latest" />
          <param name="namesAndTags" value="public-image-qodana-jvm-community" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
      <runner id="certificates_loader" name="certificates_loader" type="jetbrains_powershell">
        <parameters>
          <param name="jetbrains_powershell_bitness" value="x64" />
          <param name="jetbrains_powershell_execution" value="PS1" />
          <param name="jetbrains_powershell_noprofile" value="true" />
          <param name="jetbrains_powershell_scriptArguments" value="-destinationPath %build.certificateDestinationPath%" />
          <param name="jetbrains_powershell_script_code"><![CDATA[param (
    [string]$destinationPath
)

# Definir la ruta de origen
$sourcePath = "C:\projects\ambient\certs\directory-backend"

# Listar los archivos que se desean copiar
$filesToCopy = @("keystore.jks", "backbone.crt", "directory-rest.crt", "prod-ca-2021.crt", "prx-qa.config-server.crt","prx-qa.manager.crt", "srmn.crt")

# Comprobar si se ha proporcionado una ruta de destino
if (-Not $destinationPath) {
    Write-Output 'Por favor, proporciona una ruta de destino.'
    exit
}

# Crear el directorio de destino si no existe
if (-Not (Test-Path $destinationPath)) {
    New-Item -ItemType Directory -Path $destinationPath
}

# Copiar los archivos
foreach ($file in $filesToCopy) {
    $sourceFile = Join-Path $sourcePath $file
    $destinationPath = Join-Path $destinationPath $file

    if (Test-Path $sourceFile) {
        Copy-Item -Path $sourceFile -Destination $destinationFile
        Write-Output "Archivo copiado: $file"
    } else {
        Write-Output "Archivo no encontrado: $file"
    }
}]]></param>
          <param name="jetbrains_powershell_script_mode" value="CODE" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
      <runner id="DockerCommand" name="Docker build" type="DockerCommand">
        <parameters>
          <param name="docker.command.type" value="build" />
          <param name="docker.image.namesAndTags" value="lamata/directory-backend-api:0.0.2" />
          <param name="docker.push.remove.image" value="true" />
          <param name="dockerImage.platform" value="linux" />
          <param name="dockerfile.path" value="Dockerfile" />
          <param name="dockerfile.source" value="PATH" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
      <runner id="Docker_push" name="Docker push" type="DockerCommand">
        <parameters>
          <param name="docker.command.type" value="push" />
          <param name="docker.image.namesAndTags" value="lamata/directory-backend-api:0.0.2" />
          <param name="docker.push.remove.image" value="true" />
          <param name="dockerfile.source" value="PATH" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings>
      <vcs-entry-ref root-id="Directory_Backend_HttpsGithubComUmDevCreativeDirectoryBackendRefsHeadsMain" />
    </vcs-settings>
    <build-triggers>
      <build-trigger id="TRIGGER_10" type="vcsTrigger">
        <parameters>
          <param name="branchFilter"><![CDATA[+:main
+:development]]></param>
          <param name="enableQueueOptimization" value="true" />
          <param name="quietPeriodMode" value="DO_NOT_USE" />
        </parameters>
      </build-trigger>
    </build-triggers>
    <build-extensions>
      <extension id="perfmon" type="perfmon" />
      <extension id="BUILD_EXT_1" type="BuildFailureOnMetric">
        <parameters>
          <param name="anchorBuild" value="lastSuccessful" />
          <param name="metricKey" value="buildTestCount" />
          <param name="metricThreshold" value="20" />
          <param name="metricUnits" value="metricUnitsPercents" />
          <param name="moreOrLess" value="less" />
          <param name="withBuildAnchor" value="true" />
        </parameters>
      </extension>
      <extension id="DockerSupport" type="DockerSupport">
        <parameters>
          <param name="cleanupPushed" value="true" />
          <param name="login2registry" value="PROJECT_EXT_10" />
          <param name="loginCheckbox" value="on" />
        </parameters>
      </extension>
    </build-extensions>
  </settings>
</build-type>

