<?xml version="1.0" encoding="UTF-8"?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="08b33659-b83c-463c-91e8-253f5a7f9722" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2025.3/project-config.xsd">
  <name>Build</name>
  <description />
  <settings>
    <disabled-settings>
      <setting-ref ref="DockerCommand" />
      <setting-ref ref="Qodana" />
    </disabled-settings>
    <build-runners>
      <runner id="Maven2" name="" type="Maven2">
        <parameters>
          <param name="goals" value="clean test" />
          <param name="localRepoScope" value="agent" />
          <param name="maven.path" value="%teamcity.tool.maven.DEFAULT%" />
          <param name="pomLocation" value="pom.xml" />
          <param name="runnerArgs" value="-Dmaven.test.failure.ignore=true" />
          <param name="target.jdk.home" value="%env.JDK_21_0_x64%" />
          <param name="teamcity.step.mode" value="default" />
          <param name="userSettingsSelection" value="Repsy Maven" />
        </parameters>
      </runner>
      <runner id="Qodana" name="" type="Qodana">
        <parameters>
          <param name="linterVersion" value="latest" />
          <param name="namesAndTags" value="public-image-qodana-jvm-community" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
      <runner id="DockerCommand" name="" type="DockerCommand">
        <parameters>
          <param name="docker.command.type" value="build" />
          <param name="docker.push.remove.image" value="true" />
          <param name="dockerfile.path" value="Dockerfile" />
          <param name="dockerfile.source" value="PATH" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings>
      <vcs-entry-ref root-id="Directory_Backend_HttpsGithubComUmDevCreativeDirectoryBackendRefsHeadsMain" />
    </vcs-settings>
    <build-triggers>
      <build-trigger id="TRIGGER_10" type="vcsTrigger">
        <parameters>
          <param name="branchFilter"><![CDATA[+:main
+:development]]></param>
          <param name="enableQueueOptimization" value="true" />
          <param name="quietPeriodMode" value="DO_NOT_USE" />
        </parameters>
      </build-trigger>
    </build-triggers>
    <build-extensions>
      <extension id="perfmon" type="perfmon" />
    </build-extensions>
  </settings>
</build-type>

